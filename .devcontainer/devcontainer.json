{
  "name": "tgoskits Dev Container",
  "build": {
    "context": "..",
    "dockerfile": "../container/Dockerfile"
  },
  "hostRequirements": {
    "memory": "16gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "runArgs": [
    "--privileged",
    "--device=/dev/ttyUSB0",
    "--network=host"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "rustc --version && docker --version",
  "postStartCommand": "if [ -e /dev/ttyUSB0 ]; then sudo chmod a+rw /dev/ttyUSB0; fi && if [ -d /dev/bus/usb ]; then sudo chmod -R a+rw /dev/bus/usb; fi"
}
